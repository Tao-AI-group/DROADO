    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#White_matter">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Brain"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Spinal_cord"/>
        <DROADO:Definition>The region of CENTRAL NERVOUS SYSTEM that appears lighter in color than the other type, GRAY MATTER. It mainly consists of MYELINATED NERVE FIBERS and contains few neuronal cell bodies or DENDRITES.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D066127</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


