    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Hydrocephalus -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Hydrocephalus">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Brain_Disease"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Pathology"/>
        <DROADO:Definition>Excessive accumulation of cerebrospinal fluid within the cranium which may be associated with dilation of cerebral ventricles, INTRACRANIAL HYPERTENSION; HEADACHE; lethargy; URINARY INCONTINENCE; and ATAXIA.

