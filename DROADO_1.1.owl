    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Nucleus_accumbens -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Nucleus_accumbens">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Ventral_striatum"/>
        <DROADO:Definition>Collection of pleomorphic cells in the caudal part of the anterior horn of the LATERAL VENTRICLE, in the region of the OLFACTORY TUBERCLE, lying between the head of the CAUDATE NUCLEUS and the ANTERIOR PERFORATED SUBSTANCE. It is part of the so-called VENTRAL STRIATUM, a composite structure considered part of the BASAL GANGLIA.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D009714</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


