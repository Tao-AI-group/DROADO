        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Olfactory_cortex"/>
        <DROADO:Definition>An area of the olfactory cortex comprising the rostral half of the uncus of the PARAHIPPOCAMPAL GYRUS and the anterior PARAHIPPOCAMPAL GYRUS. It receives major afferents directly from the OLFACTORY BULB.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D066195</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


