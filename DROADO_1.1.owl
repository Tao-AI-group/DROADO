        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Temporal_lobe"/>
        <DROADO:Definition>An area in the temporal lobe that is important for memory encoding and retrieval. It is bordered caudally by the parahippocampal cortex (see HIPPOCAMPUS) and ventrally and medially by the ENTORHINAL CORTEX.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D000071039</DROADO:MeSH_Unique_ID>
