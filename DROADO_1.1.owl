    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Purkinje_cell">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Cerebellar_cortex"/>
        <DROADO:Definition>The output neurons of the cerebellar cortex.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D011689</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Putamen -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Putamen">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Neostriatum"/>
        <DROADO:Definition>The largest and most lateral of the BASAL GANGLIA lying between the lateral medullary lamina of the GLOBUS PALLIDUS and the EXTERNAL CAPSULE. It is part of the neostriatum and forms part of the LENTIFORM NUCLEUS along with the GLOBUS PALLIDUS.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D011699</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Pyramidal_tract -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Pyramidal_tract">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Spinal_cord"/>
        <DROADO:Definition>Fibers that arise from cells within the cerebral cortex, pass through the medullary pyramid, and descend in the spinal cord. Many authorities say the pyramidal tracts include both the corticospinal and corticobulbar tracts.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D011712</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


