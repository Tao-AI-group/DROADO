        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Spinal_cord"/>
        <DROADO:Definition>Region of CENTRAL NERVOUS SYSTEM that appears darker in color than the other type, WHITE MATTER. It is composed of neuronal CELL BODIES; NEUROPIL; GLIAL CELLS and CAPILLARIES but few MYELINATED NERVE FIBERS.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D066128</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


