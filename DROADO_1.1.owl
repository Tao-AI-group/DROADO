        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Telencephalon"/>
        <DROADO:Definition>WHITE MATTER pathway, flanked by nuclear masses, consisting of both afferent and efferent fibers projecting between the WHITE MATTER and the BRAINSTEM. It consists of three distinct parts: an anterior limb, posterior limb, and genu.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D020772</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


