        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Tegmentum_mesencephali"/>
        <DROADO:Definition>A collection of nuclei in the midbrain tegmentum for the OCULOMOTOR NERVE fibers.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D065838</DROADO:MeSH_Unique_ID>
