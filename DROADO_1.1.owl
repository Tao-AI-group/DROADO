        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Reticular_formation"/>
        <DROADO:Definition>Part of the brain located in the MEDULLA OBLONGATA and PONS. It receives neural, chemical and hormonal signals, and controls the rate and depth of respiratory movements of the DIAPHRAGM and other respiratory muscles.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D012125</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


