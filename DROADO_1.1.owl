    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Midline_thalamic_nucleus -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Midline_thalamic_nucleus">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Thalamic_nuclei"/>
        <DROADO:Definition>Small, nonspecific nerve cells scattered in the periventricular GRAY MATTER, separating the medial part of the thalamus from the EPENDYMA of the THIRD VENTRICLE. The group includes the paraventricular nucleus, paratenial nucleus, reuniens nucleus, rhomboidal nucleus, and subfascular nucleus.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D020644</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Mild_cognitive_impairment_due_to_AD -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Mild_cognitive_impairment_due_to_AD">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#AD_Stage"/>
        <DROADO:Definition>National Institute on Aging - Alzheimer Association (NIA-AA) criteria: requires evidence of intra-individual decline, manifested by  a change in cognition from previously attained levels, impaired cognition in at least one domain (but not necessarily episodic memory), preserved independence in functional abilities, and no dementia</DROADO:Definition>
        <DROADO:Description>Characterized by mild cognitive impairment; patients have objective cognitive decline in one or more domains; capable of independent living</DROADO:Description>
        <DROADO:Synonym>Predementia phase; Prodromal AD 

International Working Group (IWG) criteria: Predementia AD is represented by prodromal AD, with episodic memory impairment that is insufficient to disrupt the performance of accustomed instrumental activities of daily living (IADL).</DROADO:Synonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Mild_stage_of_dementia_due_to_AD -->

