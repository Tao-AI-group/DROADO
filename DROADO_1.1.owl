    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Clusterin -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Clusterin">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Drug_target"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Cochlear_nucleus -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Cochlear_nucleus">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Pons"/>
        <DROADO:Definition>The brain stem nucleus that receives the central input from the cochlear nerve. The cochlear nucleus is located lateral and dorsolateral to the inferior cerebellar peduncles and is functionally divided into dorsal and ventral parts. It is tonotopically organized, performs the first stage of central auditory processing, and projects (directly or indirectly) to higher auditory areas including the superior olivary nuclei, the medial geniculi, the inferior colliculi, and the auditory cortex.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D017626</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Cognitive_dysfunction -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Cognitive_dysfunction">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Symptom"/>
        <DROADO:Definition>Diminished or impaired mental and/or intellectual function.</DROADO:Definition>
        <DROADO:Synonym>Cognitive decline</DROADO:Synonym>
        <Gene1:Locus_MIM_number>D060825</Gene1:Locus_MIM_number>
    </owl:Class>
    


