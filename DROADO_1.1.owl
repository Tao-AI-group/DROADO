        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_Cortex"/>
        <DROADO:Definition>Upper central part of the cerebral hemisphere. It is located posterior to central sulcus, anterior to the OCCIPITAL LOBE, and superior to the TEMPORAL LOBES.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D010296</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


