    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Mesencephalon -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Mesencephalon">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Brain_stem"/>
        <DROADO:Definition>The middle of the three primitive cerebral vesicles of the embryonic brain. Without further subdivision, midbrain develops into a short, constricted portion connecting the PONS and the DIENCEPHALON. Midbrain contains two major parts, the dorsal TECTUM MESENCEPHALI and the ventral TEGMENTUM MESENCEPHALI, housing components of auditory, visual, and other sensorimoter systems.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D008636</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


