    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Reticular_formation">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Brain_stem"/>
        <DROADO:Definition>A region extending from the PONS &amp; MEDULLA OBLONGATA through the MESENCEPHALON, characterized by a diversity of neurons of various sizes and shapes, arranged in different aggregations and enmeshed in a complicated fiber network.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D012154</DROADO:MeSH_Unique_ID>
