        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Pineal_gland"/>
        <DROADO:Definition>A small protuberance at the dorsal, posterior corner of the wall of the THIRD VENTRICLE, adjacent to the dorsal THALAMUS and PINEAL BODY. It contains the habenular nuclei and is a major part of the epithalamus.</DROADO:Definition>
