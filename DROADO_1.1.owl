    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Corpus_callosum -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Corpus_callosum">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Telencephalic_commissure"/>
        <DROADO:Definition>Broad plate of dense myelinated fibers that reciprocally interconnect regions of the cortex in all lobes with corresponding regions of the opposite hemisphere. The corpus callosum is located deep in the longitudinal fissure.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D003337</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Corpus_striatum -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Corpus_striatum">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Basal_Ganglia"/>
        <DROADO:Definition>Striped GRAY MATTER and WHITE MATTER consisting of the NEOSTRIATUM and paleostriatum (GLOBUS PALLIDUS). It is located in front of and lateral to the THALAMUS in each cerebral hemisphere. The gray substance is made up of the CAUDATE NUCLEUS and the lentiform nucleus (the latter consisting of the GLOBUS PALLIDUS and PUTAMEN). The WHITE MATTER is the INTERNAL CAPSULE.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D003342</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Corticomedial_nuclear_complex -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Corticomedial_nuclear_complex">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Amygdala"/>
        <DROADO:Definition>The rostral part of the amygdala with cortical-like layered structure. It receives major inputs from the OLFACTORY BULB and PIRIFORM CORTEX.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D066276</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


