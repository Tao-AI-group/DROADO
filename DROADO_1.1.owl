        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Epithalamus"/>
        <DROADO:Definition>A light-sensitive neuroendocrine organ attached to the roof of the THIRD VENTRICLE of the brain. The pineal gland secretes MELATONIN, other BIOGENIC AMINES and NEUROPEPTIDES.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D010870</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


