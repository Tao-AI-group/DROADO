        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Anterior_pituitary_gland"/>
        <DROADO:Definition>Anterior pituitary cells that can produce both FOLLICLE STIMULATING HORMONE and LUTEINIZING HORMONE.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D052681</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Granulovacuolar_degeneration -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Granulovacuolar_degeneration">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Microscopic_lesion"/>
        <DROADO:Description>Describes an abnormality in which the neuronal cytoplasm of hippocampal pyramidal cells is replaced by vacuoles containing small basophilic granules; these may represent an abnormality of neuronal autophagy. Hippocampi showing prominent GVD also often show eosinophilic hyaline rodlike structures—rodlike bodies of Hirano—in the neuropil.

https://doi.org/10.1146/annurev-pathol-020712-163927</DROADO:Description>
        <DROADO:Synonym>GVD, of Simchowicz</DROADO:Synonym>
        <DROADO:UMLS_CUI>C0333454; C0333455</DROADO:UMLS_CUI>
    </owl:Class>
    


