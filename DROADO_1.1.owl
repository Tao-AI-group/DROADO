        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Hypothalamo-hypophyseal_system"/>
        <DROADO:Definition>A small, unpaired gland situated in the SELLA TURCICA. It is connected to the HYPOTHALAMUS by a short stalk which is called the INFUNDIBULUM.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D010902</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Plasmolipin -->

