    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Prosencephalon -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Prosencephalon">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Brain"/>
        <DROADO:Definition>The anterior of the three primitive cerebral vesicles of the embryonic brain arising from the NEURAL TUBE. It subdivides to form DIENCEPHALON and TELENCEPHALON. (Stedmans Medical Dictionary, 27th ed)</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D016548</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


