    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Sphingosine-1-phosphate_receptor_1">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Drug_target"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Spi-1_proto-oncogene -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Spi-1_proto-oncogene">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Drug_target"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Spinal_Cord_Diseases -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Spinal_Cord_Diseases">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Central_Nervous_System_Disease"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Spinal_cord -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Spinal_cord">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Central_nervous_system"/>
        <DROADO:Definition>A cylindrical column of tissue that lies within the vertebral canal. It is composed of WHITE MATTER and GRAY MATTER.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D013116</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Spinal_cord_dorsal_horn -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Spinal_cord_dorsal_horn">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Spinal_cord"/>
        <DROADO:Definition>One of three central columns of the spinal cord. It is composed of GRAY MATTER spinal laminae I-VI.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D066148</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Spinal_cord_lateral_horn -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Spinal_cord_lateral_horn">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Spinal_cord"/>
        <DROADO:Definition>One of three central columns of the spinal cord. It is composed of GRAY MATTER and is located laterally in lamina VII.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D066152</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Spinal_cord_ventral_horn -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Spinal_cord_ventral_horn">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Spinal_cord"/>
        <DROADO:Definition>One of three central columns of the spinal cord. It is composed of GRAY MATTER spinal laminae VIII and IX.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D066151</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Spinal_trigeminal_nucleus -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Spinal_trigeminal_nucleus">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Medulla_oblongata"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Pontine_tegmentum"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Trigeminal_nuclei"/>
        <DROADO:Definition>Nucleus of the spinal tract of the trigeminal nerve. It is divided cytoarchitectonically into three parts: oralis, caudalis (TRIGEMINAL CAUDAL NUCLEUS), and interpolaris.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D014279</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Spinothalamic_tract -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Spinothalamic_tract">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Spinal_cord"/>
        <DROADO:Definition>A bundle of NERVE FIBERS connecting each posterior horn of the spinal cord to the opposite side of the THALAMUS, carrying information about pain, temperature, and touch. It is one of two major routes by which afferent spinal NERVE FIBERS carrying sensations of somaesthesis are transmitted to the THALAMUS.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D013133</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Spleen_associated_tyrosine_kinase -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Spleen_associated_tyrosine_kinase">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Drug_target"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Sporadic_AD -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Sporadic_AD">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#AD_Subtype"/>
        <DROADO:Description>Multifactorial disease with high complexity; about 99% AD cases; characterized by amyloid beta deposits and tau tangles in neocortical brain regions</DROADO:Description>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Star_related_lipid_transfer_domain_containing_10 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Star_related_lipid_transfer_domain_containing_10">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Drug_target"/>
    </owl:Class>
    


