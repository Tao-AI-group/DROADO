        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Tegmentum_mesencephali"/>
        <DROADO:Definition>Central gray matter surrounding the CEREBRAL AQUEDUCT in the MESENCEPHALON. Physiologically it is probably involved in RAGE reactions, the LORDOSIS REFLEX; FEEDING responses, bladder tonus, and pain.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D010487</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


