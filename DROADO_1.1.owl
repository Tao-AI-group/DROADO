    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Intermediate_pituitary_gland -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Intermediate_pituitary_gland">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Pituitary_gland"/>
        <DROADO:Definition>The intermediate lobe of the pituitary gland. It shows considerable size variation among the species, small in humans, and large in amphibians and lower vertebrates. This lobe produces mainly MELANOCYTE-STIMULATING HORMONES and other peptides from post-translational processing of pro-opiomelanocortin (POMC).</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D052716</DROADO:MeSH_Unique_ID>
        <DROADO:Synonym>Pituitary gland, intermediate</DROADO:Synonym>
    </owl:Class>
    


