    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Perforant_pathway">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Limbic_system"/>
        <DROADO:Definition>A pathway of fibers that originates in the lateral part of the ENTORHINAL CORTEX, perforates the SUBICULUM of the HIPPOCAMPUS, and runs into the stratum moleculare of the hippocampus, where these fibers synapse with others that go to the DENTATE GYRUS where the pathway terminates. It is also known as the perforating fasciculus.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D019580</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Periamygdaloid_cortex -->

