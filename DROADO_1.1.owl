    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Choroid_plexus -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Choroid_plexus">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_ventricle"/>
        <DROADO:Definition>A villous structure of tangled masses of BLOOD VESSELS contained within the third, lateral, and fourth ventricles of the BRAIN. It regulates part of the production and composition of CEREBROSPINAL FLUID.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D002831</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Chromodomain_Y_like -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Chromodomain_Y_like">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Drug_target"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Chronic_Brain_Damage -->

