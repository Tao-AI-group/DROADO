        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Brain"/>
        <DROADO:Definition>The part of the brain that connects the CEREBRAL HEMISPHERES with the SPINAL CORD. It consists of the MESENCEPHALON; PONS; and MEDULLA OBLONGATA.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D001933</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


