    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Pia_mater">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Meninge"/>
        <DROADO:Definition>The innermost layer of the three meninges covering the brain and spinal cord. It is the fine vascular membrane that lies under the ARACHNOID and the DURA MATER.</DROADO:Definition>
