    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Preclinical_AD -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Preclinical_AD">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#AD_Stage"/>
        <DROADO:Definition>National Institute on Aging - Alzheimer Association (NIA-AA) criteria: requires in vivo molecular biomarkers of AD are present, but clinical symptoms are absent

International Working Group (IWG) criteria: Refers to the stage of AD that is not clinically expressed; that is, although the molecular pathology of AD is present in the brain, symptoms are absent. The use of the preclinical AD definition signifies that this stage can only be detected by AD biomarkers, and not by currently available clinical methods.</DROADO:Definition>
        <DROADO:Description>Cognitive decline greater than expected for their age and education level but does not significantly interfere with everyday activities; Alzheimer’s disease pathology already present in the brain; amyloid positivity associated with increased risk of clinical progression; individual cognitively intact; key for early intervention, treatment, and prognosis</DROADO:Description>
        <DROADO:Synonym>Presymptomatic phase</DROADO:Synonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Prefrontal_cortex -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Prefrontal_cortex">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Frontal_lobe"/>
        <DROADO:Definition>The rostral part of the frontal lobe, bounded by the inferior precentral fissure in humans, which receives projection fibers from the MEDIODORSAL NUCLEUS OF THE THALAMUS. The prefrontal cortex receives afferent fibers from numerous structures of the DIENCEPHALON; MESENCEPHALON; and LIMBIC SYSTEM as well as cortical afferents of visual, auditory, and somatic origin.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D017397</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Preoptic_area -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Preoptic_area">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Anterior_hypothalamus"/>
        <DROADO:Definition>Region of hypothalamus between the ANTERIOR COMMISSURE and OPTIC CHIASM.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D011301</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Presymptomatic_AD -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Presymptomatic_AD">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Preclinical_AD"/>
        <DROADO:Definition>International Working Group (IWG) criteria: cognitively normal individual with evidence of AD molecular pathology; unknown whether progression to symptomatic AD will occur</DROADO:Definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Pretectal_region -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Pretectal_region">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Tectum_mesencephali"/>
        <DROADO:Definition>Region of midbrain tectum located posterior to the THALAMUS and anterior to the SUPERIOR COLLICULUS.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D066250</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


