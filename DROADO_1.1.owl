        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Midbrain_reticular_formation"/>
        <DROADO:Definition>Dense collection of cells in the caudal pontomesencephalic tegmentum known to play a role in the functional organization of the BASAL GANGLIA and in the modulation of the thalamocortical neuronal system.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D045042</DROADO:MeSH_Unique_ID>
