    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Wernicke_area -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Wernicke_area">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Parietal_lobe"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Temporal_lobe"/>
        <DROADO:Definition>Functional region comprising posterior part of the SUPERIOR TEMPORAL GYRUS in the dominant cerebral hemisphere (see CEREBRAL DOMINANCE) and often portions of the PARIETAL LOBE. Along with BROCA AREA it is important in SPEECH and LANGUAGE processes. A lesion in the area is associated with WERNICKE APHASIA and CONDUCTION APHASIA.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D065813</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


