    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Dementia_due_to_AD -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Dementia_due_to_AD">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#AD_Stage"/>
        <DROADO:Definition>National Institute on Aging - Alzheimer Association (NIA-AA) criteria: the presence of dementia determined by intra-individual decline in cognition and function, insidious onset and progressive cognitive decline, impairment in two or more cognitive domains, and absence of prominent features associated with other dementing disorders

International Working Group (IWG) criteria: indicates that episodic memory loss and other cognitive symptoms are sufficient to interfere with the usual performance of IADL</DROADO:Definition>
        <DROADO:Description>Noticeable memory, thinking, and behavioral symptoms that impair person’s ability to function in daily life</DROADO:Description>
    </owl:Class>
    


