    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Visual_cortex -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Visual_cortex">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Occipital_lobe"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Sensorimotor_cortex"/>
        <DROADO:Definition>Area of the OCCIPITAL LOBE concerned with the processing of visual information relayed via VISUAL PATHWAYS.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D014793</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Visual_loss -->

