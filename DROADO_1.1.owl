    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Cerebellar_vermis -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Cerebellar_vermis">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Cerebellar_cortex"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Purkinje_cell"/>
        <DROADO:Definition>A subregion of the CEREBELLAR CORTEX, located along the midsagittal plane of the CEREBELLUM.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D065814</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Cerebellopontine_angle -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Cerebellopontine_angle">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Cerebellum"/>
        <DROADO:Definition>Junction between the cerebellum and the pons.</DROADO:Definition>
        <DROADO:Location>D002530</DROADO:Location>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Cerebellum -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Cerebellum">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Metencephalon"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Pons"/>
        <DROADO:Definition>The part of brain that lies behind the BRAIN STEM in the posterior base of skull (CRANIAL FOSSA, POSTERIOR). It is also known as the &quot;little brain&quot; with convolutions similar to those of CEREBRAL CORTEX, inner white matter, and deep cerebellar nuclei. Its function is to coordinate voluntary movements, maintain balance, and learn motor skills.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D002531</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_Cortex -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_Cortex">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Cerebrum"/>
        <DROADO:Definition>The thin layer of GRAY MATTER on the surface of the CEREBRAL HEMISPHERES that develops from the TELENCEPHALON and folds into gyri and sulchi. It reaches its highest development in humans and is responsible for intellectual faculties and higher mental functions.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D002540</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_amyloid_angiopathy -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_amyloid_angiopathy">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Amyloid_pathology"/>
        <DROADO:Definition>A heterogeneous group of sporadic or familial disorders characterized by AMYLOID deposits in the walls of small and medium sized blood vessels of CEREBRAL CORTEX and MENINGES. Clinical features include multiple, small lobar CEREBRAL HEMORRHAGE; cerebral ischemia (BRAIN ISCHEMIA); and CEREBRAL INFARCTION. Cerebral amyloid angiopathy is unrelated to generalized AMYLOIDOSIS. Amyloidogenic peptides in this condition are nearly always the same ones found in ALZHEIMER DISEASE. (from Kumar: Robbins and Cotran: Pathologic Basis of Disease, 7th ed., 2005)

From MSH</DROADO:Definition>
        <DROADO:Description>CAA is less prominently featured (than SPs and NFTs) when considering AD neuropathologic lesions in part because it is variable in severity among AD patients, though when sought diligently it is identified in an estimated 85–95% of AD brains. CAA results from a process whereby the media of parenchymal arterioles, normally composed of smooth muscle cells (SMCs), undergoes progressive loss of these SMCs and simultaneous accumulation of an eosinophilic hyaline material that has the staining properties of amyloid, that is, positivity for thioflavin S or T and congophilia, with the characteristic yellow-green birefringence (of the congophilic material) when a brain section is viewed under polarized light.

https://doi.org/10.1146/annurev-pathol-020712-163927</DROADO:Description>
        <DROADO:Synonym>CAA</DROADO:Synonym>
        <DROADO:UMLS_CUI>C0085220</DROADO:UMLS_CUI>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_aqueduct -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_aqueduct">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_ventricle"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Tegmentum_mesencephali"/>
        <DROADO:Definition>Narrow channel in the MESENCEPHALON that connects the third and fourth CEREBRAL VENTRICLES.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D002535</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_cortical_atrophy -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_cortical_atrophy">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Pathology"/>
        <DROADO:Definition>Atrophy of the cortex of the cerebrum.

From HPO</DROADO:Definition>
        <DROADO:UMLS_CUI>C4551583</DROADO:UMLS_CUI>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_crus -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_crus">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_peduncle"/>
        <DROADO:Definition>Anterior portion of the cerebral peduncle which contains the motor tracts.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D065843</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_endothelial_cell_adhesion_molecule -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_endothelial_cell_adhesion_molecule">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Drug_target"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_peduncle -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_peduncle">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Mesencephalon"/>
        <DROADO:Definition>Ventral portion of the mesencephalon including the MIDBRAIN TEGMENTUM; CRUS CEREBRI; and the PRETECTUM. It does not include tectum mesencephali and TROCHLEAR NERVE.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D065850</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_ventricle -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_ventricle">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Brain"/>
        <DROADO:Definition>Four CSF-filled (see CEREBROSPINAL FLUID) cavities within the cerebral hemispheres (LATERAL VENTRICLES), in the midline (THIRD VENTRICLE) and within the PONS and MEDULLA OBLONGATA (FOURTH VENTRICLE).</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D002552</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Cerebrovascular_Disorder -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Cerebrovascular_Disorder">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Brain_Disease"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Cerebrum -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Cerebrum">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Telencephalon"/>
        <DROADO:Definition>Derived from TELENCEPHALON, cerebrum is composed of a right and a left hemisphere. Each contains an outer cerebral cortex and a subcortical basal ganglia. The cerebrum includes all parts within the skull except the MEDULLA OBLONGATA, the PONS, and the CEREBELLUM. Cerebral functions include sensorimotor, emotional, and intellectual activities.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D054022</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Cervical_cord -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Cervical_cord">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Spinal_cord"/>
        <DROADO:Definition>The segment of the spinal cord within the CERVICAL VERTEBRAE.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D066193</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Change_in_episodic_memory -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Change_in_episodic_memory">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Short-term_memory_impairment"/>
        <DROADO:Description>Amnestic syndrome: free and cued recall abilities impaired; remembering new information becomes difficult</DROADO:Description>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Chaperonin_containing_TCP1_subunit_6B -->

