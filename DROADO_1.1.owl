    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Cisterna_magna">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Subarachnoid_space"/>
        <DROADO:Definition>One of three principal openings in the SUBARACHNOID SPACE. They are also known as cerebellomedullary cistern, and collectively as cisterns.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D002946</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


