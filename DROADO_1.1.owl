    <!-- http://purl.obolibrary.org/obo/DROADO.owl#High_vocal_center -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#High_vocal_center">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Neostriatum"/>
        <DROADO:Definition>Nucleus in the NEOSTRIATUM of bird brains that sends signals for song production and receives auditory input. In some adult SONGBIRDS, research has shown that the size of this nucleus changes seasonally and that it exhibits neurogenesis.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D053400</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Hippocampal_CA1_region -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Hippocampal_CA1_region">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Hippocampus"/>
        <DROADO:Description>One of four subsections of the hippocampus described by Lorente de No, located furthest from the DENTATE GYRUS.</DROADO:Description>
        <DROADO:MeSH_Unique_ID>D056547</DROADO:MeSH_Unique_ID>
        <DROADO:Synonym>CA1_region,_hippocampal</DROADO:Synonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Hippocampal_CA2_region -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Hippocampal_CA2_region">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Hippocampus"/>
        <DROADO:Description>A subsection of the hippocampus, described by Lorente de No, that is located between the HIPPOCAMPUS CA1 FIELD and the HIPPOCAMPUS CA3 FIELD.</DROADO:Description>
        <DROADO:MeSH_Unique_ID>D056651</DROADO:MeSH_Unique_ID>
        <DROADO:Synonym>CA2_region,_hippocampal</DROADO:Synonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Hippocampal_CA3_region -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Hippocampal_CA3_region">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Hippocampus"/>
        <DROADO:Description>A subsection of the hippocampus, described by Lorente de No, that is located between the HIPPOCAMPUS CA2 FIELD and the DENTATE GYRUS.</DROADO:Description>
        <DROADO:MeSH_Unique_ID>D056654</DROADO:MeSH_Unique_ID>
        <DROADO:Synonym>CA3_region,_hippocampal</DROADO:Synonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Hippocampal_mossy_fibers -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Hippocampal_mossy_fibers">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Dentate_gyrus"/>
        <DROADO:Description>Axons of certain cells in the DENTATE GYRUS. They project to the polymorphic layer of the dentate gyrus and to the proximal dendrites of PYRAMIDAL CELLS of the HIPPOCAMPUS. These mossy fibers should not be confused with mossy fibers that are cerebellar afferents (see NERVE FIBERS).</DROADO:Description>
        <DROADO:MeSH_Unique_ID>D019599</DROADO:MeSH_Unique_ID>
        <DROADO:Synonym>Mossy_Fibers,_Hippocampal</DROADO:Synonym>
    </owl:Class>
    


