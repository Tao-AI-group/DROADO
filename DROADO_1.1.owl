    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Structural_molecule_activity">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Molecular_function"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Subarachnoid_space -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Subarachnoid_space">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Arachnoid"/>
        <DROADO:Definition>The space between the arachnoid membrane and PIA MATER, filled with CEREBROSPINAL FLUID. It contains large blood vessels that supply the BRAIN and SPINAL CORD.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D013346</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Subcommissural_organ -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Subcommissural_organ">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Tectum_mesencephali"/>
        <DROADO:Definition>Ependymal derivative located at the junction of the THIRD VENTRICLE and the CEREBRAL AQUEDUCT; and the SOMATOSTATIN SECRETING CELLS.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D013351</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Subcortical_white_matter_atrophy -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Subcortical_white_matter_atrophy">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Leukoaraiosis"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Subcortical_white_matter_pallor -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Subcortical_white_matter_pallor">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Leukoaraiosis"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Subcortical_white_matter_shrinkage -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Subcortical_white_matter_shrinkage">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Leukoaraiosis"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Subdural_Effusion -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Subdural_Effusion">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Brain_Disease"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Subdural_space -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Subdural_space">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Dura_mater"/>
        <DROADO:Definition>Potential cavity which separates the ARACHNOID MATER from the DURA MATER.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D013355</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Subjective_cognitive_decline -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Subjective_cognitive_decline">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Cognitive_dysfunction"/>
        <DROADO:Description>Personal sensation of cognitive decline despite results within healthy limits on cognitive tests; associated with increased risk of progression to dementia, especially when patient worried about decline; more brain abnormalities: hippocampal volume loss, hypometabolism; cerebrospinal amyloid β strongly predictive of subsequent clinical progression</DROADO:Description>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Substantia_gelatinosa -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Substantia_gelatinosa">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Posterior_horn_cell"/>
        <DROADO:Definition>Gelatinous-appearing material in the dorsal horn of the spinal cord, consisting chiefly of Golgi type II neurons and some larger nerve cells.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D013376</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Substantia_innominata -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Substantia_innominata">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Basal_Ganglia"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Limbic_system"/>
        <DROADO:Definition>Tissue in the BASAL FOREBRAIN inferior to the anterior perforated substance, and anterior to the GLOBUS PALLIDUS and ansa lenticularis. It contains the BASAL NUCLEUS OF MEYNERT.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D013377</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Substantia_nigra -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Substantia_nigra">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_peduncle"/>
        <DROADO:Definition>The black substance in the ventral midbrain or the nucleus of cells containing the black substance. These cells produce DOPAMINE, an important neurotransmitter in regulation of the sensorimotor system and mood. The dark colored MELANIN is a by-product of dopamine synthesis.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D013378</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Subthalamic_nucleus -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Subthalamic_nucleus">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Subthalamus"/>
        <DROADO:Definition>Lens-shaped structure on the inner aspect of the INTERNAL CAPSULE. The SUBTHALAMIC NUCLEUS and pathways traversing this region are concerned with the integration of somatic motor function.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D020531</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Subthalamus -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Subthalamus">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Diencephalon"/>
        <DROADO:Definition>A transition zone in the anterior part of the diencephalon interposed between the thalamus, hypothalamus, and tegmentum of the mesencephalon. Components of the subthalamus include the SUBTHALAMIC NUCLEUS, zona incerta, nucleus of field H, and the nucleus of ansa lenticularis. The latter contains the ENTOPEDUNCULAR NUCLEUS.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D020530</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Succinate_dehydrogenase_complex_flavoprotein_subunit_A -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Succinate_dehydrogenase_complex_flavoprotein_subunit_A">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Drug_target"/>
    </owl:Class>
    


