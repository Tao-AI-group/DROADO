    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Meninge -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Meninge">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Central_nervous_system"/>
        <DROADO:Definition>The three membranes that cover the BRAIN and the SPINAL CORD. They are the dura mater, the arachnoid, and the pia mater.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D008578</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


