        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl/1.1"/>
        <dc:creator>Li, Fang</dc:creator>
        <dc:creator>Tao, Cui</dc:creator>
        <dc:description>The Drug Repurposing-Oriented Alzheimer&apos;s Disease Ontology (DROADO) provides a formal semantic framework that integrates essential concepts relevant to drug repurposing for Alzheimer&apos;s Disease.</dc:description>
        <dc:title>Drug Repurposing-Oriented Alzheimer&apos;s Disease Ontology</dc:title>
        <terms:license>http://creativecommons.org/licenses/by/4.0/</terms:license>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.1</owl:versionInfo>
    </owl:Ontology>
    


