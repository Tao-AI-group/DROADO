        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Anterior_pituitary_gland"/>
        <DROADO:Definition>Anterior pituitary cells that produce PROLACTIN.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D052682</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Lateral_hypothalamic_area -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Lateral_hypothalamic_area">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Hypothalamus"/>
        <DROADO:Definition>Area in the hypothalamus bounded medially by the mammillothalamic tract and the anterior column of the FORNIX (BRAIN). The medial edge of the INTERNAL CAPSULE and the subthalamic region form its lateral boundary. It contains the lateral hypothalamic nucleus, tuberomammillary nucleus, lateral tuberal nuclei, and fibers of the MEDIAL FOREBRAIN BUNDLE.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D007026</DROADO:MeSH_Unique_ID>
        <DROADO:Synonym>Hypothalamic area, lateral</DROADO:Synonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Lateral_thalamic_nuclei -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Lateral_thalamic_nuclei">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Thalamic_nuclei"/>
        <DROADO:Definition>A narrow strip of cell groups on the dorsomedial surface of the thalamus. It includes the lateral dorsal nucleus, lateral posterior nucleus, and the PULVINAR.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D020647</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Lateral_ventricle -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Lateral_ventricle">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Cerebral_ventricle"/>
        <DROADO:Definition>Cavity in each of the CEREBRAL HEMISPHERES derived from the cavity of the embryonic NEURAL TUBE. They are separated from each other by the SEPTUM PELLUCIDUM, and each communicates with the THIRD VENTRICLE by the foramen of Monro, through which also the choroid plexuses (CHOROID PLEXUS) of the lateral ventricles become continuous with that of the third ventricle.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D020547</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Lateral_vestibular_nucleus -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Lateral_vestibular_nucleus">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Vestibular_nuclei"/>
        <DROADO:Definition>Vestibular nucleus lying immediately superior to the inferior vestibular nucleus and composed of large multipolar nerve cells. Its upper end becomes continuous with the superior vestibular nucleus.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D003689</DROADO:MeSH_Unique_ID>
        <DROADO:Synonym>Vestibular nucleus, lateral</DROADO:Synonym>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Leucine_rich_pentatricopeptide_repeat_containing -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Leucine_rich_pentatricopeptide_repeat_containing">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Drug_target"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Leukoaraiosis -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Leukoaraiosis">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Pathology"/>
        <DROADO:Description>Non-specific white matter changes in the BRAIN, often seen after age 65. Changes include loss of AXONS; MYELIN pallor, GLIOSIS, loss of ependymal cells, and enlarged perivascular spaces. Leukoaraiosis is a risk factor for DEMENTIA and CEREBROVASCULAR DISORDERS.

From MSH</DROADO:Description>
        <DROADO:MeSH_Unique_ID>D049292</DROADO:MeSH_Unique_ID>
        <DROADO:UMLS_CUI>C0948163</DROADO:UMLS_CUI>
    </owl:Class>
    


