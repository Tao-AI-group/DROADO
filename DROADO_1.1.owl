        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Reticular_formation"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Tegmentum_mesencephali"/>
        <DROADO:Definition>The midbrain portion of the reticular formation located in the MIDBRAIN TEGMENTUM.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D066265</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Middle_cerebellar_peduncle -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Middle_cerebellar_peduncle">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Pons"/>
        <DROADO:Definition>WHITE MATTER consisting of a large bundle of paired fibers originating in the pontine nuclei in the pre pontis and the nucleus reticularis tegmenti pontis projecting to the contralateral cerebral cortex.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D065837</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DROADO.owl#Middle_hypothalamus -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DROADO.owl#Middle_hypothalamus">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Hypothalamus"/>
        <DROADO:Definition>Middle portion of the hypothalamus containing the arcuate, dorsomedial, ventromedial nuclei, the TUBER CINEREUM and the PITUITARY GLAND.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D007033</DROADO:MeSH_Unique_ID>
        <DROADO:Synonym>Hypothalamus, middle</DROADO:Synonym>
    </owl:Class>
    


