        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DROADO.owl#Olfactory_pathway"/>
        <DROADO:Definition>A convolution on the inferior surface of each cerebral hemisphere, lying between the hippocampal and collateral sulci.</DROADO:Definition>
        <DROADO:MeSH_Unique_ID>D020534</DROADO:MeSH_Unique_ID>
    </owl:Class>
    


